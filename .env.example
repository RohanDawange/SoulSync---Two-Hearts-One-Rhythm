# ==========================================
# SoulSync - Environment Variables
# ==========================================

# -------- SERVER --------
PORT=5000
CLIENT_URL=http://localhost:5173
# For Railway deploy set to: https://soulsync.up.railway.app
# For GitHub Pages set to: https://yourusername.github.io
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK (Server)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# -------- CLIENT --------
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxx
# For local dev: http://localhost:5000
# For Railway deploy: https://yourserver.up.railway.app
VITE_SERVER_URL=http://localhost:5000
# For GitHub Pages set to: /soulsync/ (your repo name)
VITE_BASE_URL=/
VITE_YOUTUBE_API_KEY=your-youtube-api-key
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id
VITE_TENOR_API_KEY=your-tenor-api-key
